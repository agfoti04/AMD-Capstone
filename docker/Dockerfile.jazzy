# Ubuntu 24.04 + ROS 2 Jazzy + Gazebo Harmonic.
# Runs alongside the Humble/Classic image in docker/Dockerfile. The rover
# selects its simulator with the xacro argument sim:=harmonic.

FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive

RUN printf 'Acquire::Retries "8";\nAcquire::http::Timeout "30";\n' > /etc/apt/apt.conf.d/80-retries \
    && apt-get update && apt-get install -y --no-install-recommends \
        ros-jazzy-ros-gz \
        ros-jazzy-gz-ros2-control \
        ros-jazzy-ros2-controllers \
        ros-jazzy-controller-manager \
        ros-jazzy-xacro \
        ros-jazzy-robot-state-publisher \
        ros-jazzy-topic-tools \
        ros-jazzy-cv-bridge \
        ros-jazzy-vision-msgs \
        ros-jazzy-image-transport \
        python3-colcon-common-extensions \
        python3-numpy \
        python3-opencv \
        xvfb \
        mesa-utils \
        libgl1-mesa-dri \
        libegl1 \
        libegl-mesa0 \
    && rm -rf /var/lib/apt/lists/*

# Headless Blender simplifies scanned rock meshes (mars_assets prepare).
RUN apt-get update && apt-get install -y --no-install-recommends blender \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
CMD ["bash"]
