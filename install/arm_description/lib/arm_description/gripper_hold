#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from std_msgs.msg import Float64MultiArray

OPEN_EFFORT = -0.15   # N·m, same value as GRIP_OPEN_EFFORT in pick_place


class GripperHold(Node):
    def __init__(self):
        super().__init__('gripper_hold')
        self.cmd = OPEN_EFFORT
        self.pub = self.create_publisher(
            Float64MultiArray, '/gripper_controller/commands', 10)
        self.create_subscription(
            Float64MultiArray, '/gripper_request', self.on_request, 10)
        self.create_timer(0.05, self.tick)

    def on_request(self, msg):
        if msg.data:
            self.cmd = float(msg.data[0])

    def tick(self):
        self.pub.publish(Float64MultiArray(data=[self.cmd]))


def main():
    rclpy.init()
    node = GripperHold()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()