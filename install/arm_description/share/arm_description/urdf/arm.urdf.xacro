
<?xml version="1.0"?>
<robot name="six_servo_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Placeholder dimensions, in meters -->
  <xacro:property name="base_h" value="0.06"/>
  <xacro:property name="upper_arm" value="0.12"/>
  <xacro:property name="forearm" value="0.12"/>
  <xacro:property name="wrist_len" value="0.06"/>

  <!-- Reusable visual link -->
  <xacro:macro name="arm_link" params="name length radius">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="arm_blue">
          <color rgba="0.2 0.4 0.8 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${length/2}"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${length/2}"/>
        <mass value="0.2"/>
        <inertia ixx="0.001" ixy="0" ixz="0"
                 iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Base -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.055" length="${base_h}"/>
      </geometry>
      <material name="base_gray">
        <color rgba="0.35 0.35 0.35 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.055" length="${base_h}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <!-- Servo 1: base rotation -->
  <link name="shoulder_mount">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="joint_gray">
        <color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
  </link>

  <joint name="base_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_mount"/>
    <origin xyz="0 0 ${base_h/2}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.35" upper="2.35" effort="5" velocity="1.0"/>
  </joint>

  <!-- Servo 2: shoulder pitch -->
  <xacro:arm_link name="upper_arm_link" length="${upper_arm}" radius="0.018"/>
  <joint name="shoulder_pitch" type="revolute">
    <parent link="shoulder_mount"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="5" velocity="1.0"/>
  </joint>

  <!-- Servo 3: elbow pitch -->
  <xacro:arm_link name="forearm_link" length="${forearm}" radius="0.015"/>
  <joint name="elbow_pitch" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 ${upper_arm}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="5" velocity="1.0"/>
  </joint>

  <!-- Servo 4: wrist pitch -->
  <xacro:arm_link name="wrist_pitch_link" length="${wrist_len}" radius="0.012"/>
  <joint name="wrist_pitch" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_pitch_link"/>
    <origin xyz="0 0 ${forearm}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="3" velocity="1.0"/>
  </joint>

  <!-- Servo 5: wrist rotation -->
  <link name="gripper_mount"/>
  <joint name="wrist_roll" type="revolute">
    <parent link="wrist_pitch_link"/>
    <child link="gripper_mount"/>
    <origin xyz="0 0 ${wrist_len}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.35" upper="2.35" effort="3" velocity="1.0"/>
  </joint>

  <!-- Servo 6: gripper opening -->
  <xacro:arm_link name="gripper_finger" length="0.05" radius="0.005"/>
  <joint name="gripper" type="revolute">
    <parent link="gripper_mount"/>
    <child link="gripper_finger"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.7" effort="2" velocity="1.0"/>
  </joint>

</robot>
