<?xml version="1.0"?>
<robot name="four_wheel_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="blue"><color rgba="0.2 0.4 0.8 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>

  <link name="base_link">
    <visual>
      <geometry><box size="0.4 0.2 0.1"/></geometry>
      <material name="blue"/>
    </visual>
    <collision><geometry><box size="0.4 0.2 0.1"/></geometry></collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.0208" iyy="0.0708" izz="0.0833" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_wheel">
      <visual>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.05" length="0.04"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      </collision>
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="0.000228" iyy="0.000375" izz="0.000228" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_wheel"/>
      <origin xyz="${x} ${y} -0.03"/><axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${name}_wheel">
      <mu1>0.6</mu1><mu2>0.6</mu2>
      <material>Gazebo/Black</material>
      <minDepth>0.001</minDepth>
      <kp>1e6</kp><kd>100</kd>
    </gazebo>
  </xacro:macro>

  <xacro:wheel name="front_left"  x="0.13"  y="0.12"/>
  <xacro:wheel name="rear_left"   x="-0.13" y="0.12"/>
  <xacro:wheel name="front_right" x="0.13"  y="-0.12"/>
  <xacro:wheel name="rear_right"  x="-0.13" y="-0.12"/>

  <ros2_control name="GazeboSystem" type="system">
    <hardware><plugin>gazebo_ros2_control/GazeboSystem</plugin></hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"><param name="min">-20</param><param name="max">20</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"><param name="min">-20</param><param name="max">20</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"><param name="min">-20</param><param name="max">20</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"><param name="min">-20</param><param name="max">20</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find four_wheel_sim)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>