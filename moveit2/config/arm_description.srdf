<?xml version="1.0" encoding="UTF-8"?>
<robot name="arm_description">
  <group name="arm">
    <joint name="Joint_1"/>
    <joint name="Joint_2"/>
    <joint name="Joint_3"/>
    <joint name="Joint_4"/>
    <joint name="Joint_6"/>
  </group>
  <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>
  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="humerus_link" reason="Adjacent"/>
  <disable_collisions link1="humerus_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_link" link2="hand_link" reason="Adjacent"/>
  <disable_collisions link1="hand_link" link2="grip_left_link" reason="Adjacent"/>
  <disable_collisions link1="hand_link" link2="grip_right_link" reason="Adjacent"/>
  <disable_collisions link1="hand_link" link2="tendon_left_link" reason="Adjacent"/>
  <disable_collisions link1="hand_link" link2="tendon_right_link" reason="Adjacent"/>
  <disable_collisions link1="grip_left_link" link2="finger_left_link" reason="Adjacent"/>
  <disable_collisions link1="grip_right_link" link2="finger_right_link" reason="Adjacent"/>
  <disable_collisions link1="hand_link" link2="EE_Gripper_Link" reason="Adjacent"/>
</robot>
